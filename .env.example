# First setup only: copy this file to .env beside notify.py if .env does not exist.
# Never overwrite an existing .env with this template; edit .env for daily settings.
# Environment variables take precedence over .env, including empty values.
# Never commit your real .env file, ntfy topic or token.
# Put comments on separate lines; inline comments after values are not supported.

# Local master switch: 1 = enabled (default); 0 = skip without sending.
# Saved .env changes take effect on the next invocation; environment overrides win.
CODEX_NOTIFY_ENABLED=1
CODEX_NOTIFY_PROVIDER=ntfy
NTFY_SERVER=https://ntfy.sh
# Replace the placeholder with a long random private topic matching your phone subscription.
# Your own computers may share one personal topic; use distinct device aliases below.
NTFY_TOPIC=replace-with-a-long-random-private-topic
# Optional bearer token for a server/account requiring authentication.
NTFY_TOKEN=

# Optional device alias: blank uses the hostname. Prefer a non-sensitive name,
# such as Windows-A or MacBook-B, to distinguish your computers.
CODEX_NOTIFY_DEVICE=
# Optional project scope: JSON array of absolute folders; [] allows all directories.
# Windows example: ["D:/Projects"]   macOS example: ["/Users/you/Projects"]
# With a nonempty scope, a missing/invalid/outside event cwd silently skips delivery.
CODEX_NOTIFY_PROJECT_ROOTS=[]
# Optional: read the matching title from Codex's local session_index.jsonl.
# Titles may contain sensitive words. 0 = disabled; 1 = enabled (default).
CODEX_NOTIFY_TASK_TITLE=1
# Timeout range: greater than 0, at most 30 seconds (no retries).
CODEX_NOTIFY_TIMEOUT=5
