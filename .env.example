# Copy this file to .env for local use if the implementation supports .env files.
# Never commit your real .env file or real ntfy topic.

CODEX_NOTIFY_PROVIDER=ntfy
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=replace-with-a-long-random-private-topic

# Optional overrides
CODEX_NOTIFY_DEVICE=
CODEX_NOTIFY_SUMMARY_MAX=300
CODEX_NOTIFY_TIMEOUT=5
